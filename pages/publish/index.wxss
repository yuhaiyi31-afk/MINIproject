/* 视频上传 */
.video-upload { width:100%; height:200rpx; box-sizing:border-box; background:#F5F5F5; border:2rpx dashed #CCC; border-radius:12rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:8rpx; }
.video-add-icon { font-size:48rpx; color:#999; }
.video-add-text { font-size:24rpx; color:#999; }
.video-preview { position:relative; border-radius:12rpx; overflow:hidden; }
.video-player { width:100%; height:360rpx; }

/* 图片上传区 */
.image-section {
  margin: 24rpx;
}

.section-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.image-item {
  width: 210rpx;
  height: 210rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  position: relative;
  overflow: hidden;
}

.uploaded-img {
  width: 100%;
  height: 100%;
}

.img-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  color: #FFFFFF;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-add {
  background: #F5F5F5;
  border: 2rpx dashed #CCCCCC;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.add-icon {
  font-size: 48rpx;
  color: #999999;
  font-weight: 300;
}

.add-text {
  font-size: 22rpx;
  color: #999999;
}

/* AI识别区 */
.ai-section {
  margin: 0 24rpx 24rpx;
  padding: 24rpx;
}

.ai-header {
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.ai-icon {
  font-size: 36rpx;
}

.ai-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.ai-loading {
  text-align: center;
  padding: 24rpx 0;
  font-size: 26rpx;
  color: #4A90D9;
}

.ai-hint {
  font-size: 24rpx;
  color: #999999;
  display: block;
  margin-bottom: 16rpx;
}

.ai-tag-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.ai-tag {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #F8F9FA;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.ai-tag-active {
  border-color: #4A90D9;
  background: #EBF3FC;
}

.ai-tag-icon {
  font-size: 40rpx;
}

.ai-tag-info {
  flex: 1;
}

.ai-tag-title {
  font-size: 26rpx;
  color: #333333;
  font-weight: 500;
  display: block;
}

.ai-tag-price {
  font-size: 22rpx;
  color: #FF6B35;
  margin-top: 4rpx;
}

/* 发布表单 */
.form-section {
  margin: 0 24rpx 24rpx;
  padding: 24rpx;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 26rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 12rpx;
  display: block;
}

.required {
  color: #FF4444;
}

.form-input {
  width: 100%;
  height: 80rpx;
  box-sizing: border-box;
  background: #F8F9FA;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #333333;
}

.form-hint {
  display: block;
  margin-top: 10rpx;
  color: #8A94A3;
  font-size: 21rpx;
  line-height: 1.5;
}

.form-textarea {
  min-height: 140rpx;
  background: #F8F9FA;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  color: #333333;
  width: 100%;
  box-sizing: border-box;
}

.form-picker-wrap {
  display: block;
  width: 100%;
}

.form-picker {
  width: 100%;
  height: 80rpx;
  box-sizing: border-box;
  background: #F8F9FA;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #333333;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-placeholder {
  color: #999999;
}

.picker-arrow {
  font-size: 22rpx;
  color: #999999;
}

.price-row {
  width: 100%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  background: #F8F9FA;
  border-radius: 12rpx;
  overflow: hidden;
}

.price-prefix {
  padding: 0 16rpx;
  font-size: 26rpx;
  color: #4A90D9;
  font-weight: 600;
  background: #EBF3FC;
  height: 80rpx;
  line-height: 80rpx;
}

.price-input {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  box-sizing: border-box;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #333333;
}

.smart-price {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  background: #FFF8E1;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #E6A23C;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.smart-price-icon {
  font-size: 28rpx;
}

/* 提交区 */
.submit-section {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  box-sizing: border-box;
  background: linear-gradient(135deg, #4A90D9, #6BA5E7);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn[disabled] {
  opacity: 0.6;
}

.submit-tip {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #CCCCCC;
  margin-top: 16rpx;
}

/* 真实性承诺 */
.promise-section { margin-top: 8rpx; }
.promise-checkbox { gap: 12rpx; padding: 8rpx 0; }
.check-box { width: 40rpx; height: 40rpx; border: 2rpx solid #CCC; border-radius: 6rpx; display: flex; align-items: center; justify-content: center; font-size: 24rpx; color: #FFF; }
.check-box.checked { background: #4A90D9; border-color: #4A90D9; }
.promise-text { font-size: 26rpx; color: #333; }
.promise-hint { font-size: 22rpx; color: #4CAF50; margin-top: 6rpx; padding-left: 52rpx; }
