<!-- 视频上传区 -->
<view class="image-section">
  <text class="campus-h1">{{isEdit ? '编辑发布' : (publishType === 'service' ? '发布服务' : '发布商品')}}</text>
  <text class="form-hint">带 * 的项目为必填</text>
  <view class="section-label">照片 *（{{images.length}}/9）</view>
  <view class="image-grid">
    <view class="image-item" wx:for="{{images}}" wx:key="index">
      <image class="uploaded-img" src="{{item}}" mode="aspectFill"></image>
      <view class="img-delete" bindtap="onDeleteImage" data-index="{{index}}">✕</view>
    </view>
    <view class="image-item image-add" wx:if="{{images.length < 9}}" bindtap="onChooseImage">
      <text class="add-icon">＋</text>
      <text class="add-text">拍照/相册</text>
    </view>
  </view>
  <view class="section-label">短视频（选填）</view>
  <view class="video-upload" wx:if="{{!videoPath}}" bindtap="onChooseVideo">
    <text class="video-add-icon">▶</text>
    <text class="video-add-text">上传短视频</text>
  </view>
  <view class="video-preview" wx:else>
    <video class="video-player" src="{{videoPath}}" controls></video>
    <view class="img-delete" bindtap="onDeleteVideo">✕</view>
  </view>
</view>

<!-- 发布表单 -->
<view class="form-section card">
  <view class="section-label">发布信息</view>

  <!-- 标题 -->
  <view class="form-item">
    <text class="form-label">标题 <text class="required">*</text></text>
    <input class="form-input" placeholder="例：iPhone 14 Pro 256G 暗紫色" 
           value="{{title}}" bindinput="onTitleInput" maxlength="50"/>
  </view>

  <!-- 价格 + 智能定价 -->
  <view class="form-item">
    <text class="form-label">价格（NZD） <text class="required">*</text></text>
    <view class="price-row">
      <view class="price-prefix">NZ$</view>
      <input class="price-input" type="digit" placeholder="0 表示免费" value="{{price}}" bindinput="onPriceInput"/>
    </view>
  </view>

  <!-- 分类 -->
  <view class="form-item">
    <text class="form-label">分类 <text class="required">*</text></text>
    <picker class="form-picker-wrap" mode="selector" range="{{publishType === 'service' ? serviceCategoryOptions : categoryOptions}}" bindchange="onCategoryChange">
      <view class="form-picker {{categoryText ? '' : 'picker-placeholder'}}">
        {{categoryText || '请选择分类'}}
        <text class="picker-arrow">▼</text>
      </view>
    </picker>
  </view>

  <block wx:if="{{publishType === 'market'}}">
    <view class="form-item">
      <text class="form-label">新旧程度 <text class="required">*</text></text>
      <picker class="form-picker-wrap" mode="selector" range="{{conditionOptions}}" bindchange="onConditionChange">
        <view class="form-picker {{condition ? '' : 'picker-placeholder'}}">
          {{condition || '请选择商品新旧程度'}}
          <text class="picker-arrow">▼</text>
        </view>
      </picker>
    </view>

    <view class="form-item">
      <text class="form-label">大概区域 <text class="required">*</text></text>
      <picker class="form-picker-wrap" mode="selector" range="{{regionOptions}}" bindchange="onRegionChange">
        <view class="form-picker {{region ? '' : 'picker-placeholder'}}">
          {{region || '请选择大概区域'}}
          <text class="picker-arrow">▼</text>
        </view>
      </picker>
      <text class="form-hint">只填写大概区域，请勿填写门牌号或精确家庭地址</text>
    </view>

    <view class="form-item">
      <text class="form-label">交付方式 <text class="required">*</text></text>
      <picker class="form-picker-wrap" mode="selector" range="{{deliveryOptions}}" bindchange="onDeliveryChange">
        <view class="form-picker {{deliveryMethod ? '' : 'picker-placeholder'}}">
          {{deliveryMethod || '请选择交付方式'}}
          <text class="picker-arrow">▼</text>
        </view>
      </picker>
    </view>
  </block>

  <!-- 描述 -->
  <view class="form-item">
    <text class="form-label">描述 <text class="required">*</text></text>
    <textarea class="form-textarea" placeholder="请描述物品状况、使用时间、配件等信息..." 
              value="{{description}}" bindinput="onDescInput" maxlength="200" auto-height/>
  </view>

  <!-- 真实性承诺 -->
  <view class="form-item promise-section">
    <view class="promise-checkbox flex-row" bindtap="onTogglePromise">
      <view class="check-box {{promiseReal ? 'checked' : ''}}">
        <text wx:if="{{promiseReal}}">✓</text>
      </view>
      <text class="promise-text">🤝 我承诺此信息真实有效</text>
    </view>
    <text class="promise-hint" wx:if="{{promiseReal}}">已勾选真实性承诺，将获得"真实承诺"徽章</text>
  </view>

  <!-- 联系方式 -->
  <view class="form-item" wx:if="{{publishType === 'service'}}">
    <text class="form-label">联系方式 <text class="required">*</text></text>
    <input class="form-input" placeholder="微信号或手机号" value="{{contact}}" bindinput="onContactInput" maxlength="50"/>
    <text class="form-hint">仅用于发布者自己管理，不会在公开列表或详情中展示</text>
  </view>
</view>

<!-- 提交按钮 -->
<view class="submit-section">
  <text wx:if="{{uploadStatus}}" class="upload-status">{{uploadStatus}}</text>
  <button class="submit-btn" bindtap="onSubmit" disabled="{{submitting}}">
    {{submitting ? (isEdit ? '保存中...' : '发布中...') : (isEdit ? '保存修改' : '检查并发布')}}
  </button>
  <text class="submit-tip">发布即表示你承诺内容合法、真实且符合平台规则</text>
</view>
