<import src="../../templates/listing-card.wxml" />
<view class="discovery">
  <view class="safety-line" bindtap="onOpenSafety" aria-role="button"><text class="safety-mark">!</text><text class="safety-copy">交易安全 · 平台不代收款，请当面验货</text><text class="safety-arrow">›</text></view>
  <view class="discover-inner">
    <view class="discover-search">
      <view class="catalog-search">
        <view class="catalog-loupe"><view class="catalog-loupe-stem"></view></view>
        <input class="catalog-field" placeholder="搜索商品或生活服务" value="{{searchKeyword}}" maxlength="60" bindinput="onSearchInput" bindfocus="onSearchFocus" bindconfirm="onSearchConfirm" confirm-type="search" />
        <text class="catalog-submit" aria-role="button" bindtap="onSearchConfirm">搜索</text>
      </view>
      <view wx:if="{{showSearchPanel}}" class="search-dismiss" bindtap="onCancelSearch">取消搜索</view>
    </view>
    <!-- 搜索联想 / 热门搜索 -->
<view class="search-panel" wx:if="{{showSearchPanel}}">
  <view class="search-panel-mask" catchtap="onCloseSearchPanel"></view>
  <view class="search-panel-content">
    <!-- 输入时：智能联想 -->
    <block wx:if="{{searchKeyword}}">
      <view class="panel-heading">
        <text class="panel-title">搜索建议</text>
        <text class="panel-count">首页匹配 {{displayList.length}} 条</text>
      </view>
      <view class="suggest-list">
        <view class="suggest-item" wx:for="{{suggestions}}" wx:key="*this" bindtap="onTapSuggestion" data-keyword="{{item}}">
          <text class="suggest-icon">🔍</text>
          <text>{{item}}</text>
        </view>
      </view>
      <view class="suggest-empty" wx:if="{{suggestions.length === 0}}">
        <text>未找到匹配结果，试试其他关键词</text>
      </view>
    </block>
    <!-- 空时：热门搜索 -->
    <block wx:else>
      <view class="panel-title">热门搜索</view>
      <view class="hot-tags">
        <text class="hot-tag" wx:for="{{hotKeywords}}" wx:key="*this" bindtap="onTapSuggestion" data-keyword="{{item}}">{{item}}</text>
      </view>
      <view class="panel-title" style="margin-top:24rpx;" wx:if="{{searchHistory.length > 0}}">搜索历史</view>
      <view class="history-list" wx:if="{{searchHistory.length > 0}}">
        <text class="history-item" wx:for="{{searchHistory}}" wx:key="*this" bindtap="onTapSuggestion" data-keyword="{{item}}">{{item}}</text>
        <text class="history-clear" catchtap="onClearHistory">清除历史</text>
      </view>
    </block>
  </view>
</view>
    <view class="discovery-heading"><text class="discovery-title">校园生活</text><text class="discovery-place">奥克兰 · 新西兰</text></view>
    <view class="shortcuts">
      <view class="shortcut-cell" wx:for="{{kingkongRow1}}" wx:key="id" bindtap="onKingkongTap" data-type="{{item.type}}" aria-role="button" aria-label="{{item.name}}">
          <view class="shortcut-badge" style="background-color: {{item.bgColor}}"><image class="shortcut-image" src="{{item.iconPath}}" mode="aspectFit" /></view><text class="shortcut-name">{{item.name}}</text>
        </view>
      <view class="shortcut-cell" wx:for="{{kingkongRow2}}" wx:key="id" bindtap="onKingkongTap" data-type="{{item.type}}" aria-role="button" aria-label="{{item.name}}">
          <view class="shortcut-badge" style="background-color: {{item.bgColor}}"><image class="shortcut-image" src="{{item.iconPath}}" mode="aspectFit" /></view><text class="shortcut-name">{{item.name}}</text>
        </view>
    </view>
    <view class="discovery-heading"><text class="discovery-title">最新商品</text><text class="discovery-link" aria-role="button" bindtap="onKingkongTap" data-type="secondhand">逛集市 ›</text></view>
    <view class="feed-grid" wx:if="{{displayList.length}}"><view class="feed-cell" wx:for="{{displayList}}" wx:key="itemKey" bindtap="onInfoTap" data-item="{{item}}" aria-role="button">
      <template is="listing-card" data="{{item, coverFailed: failedCovers[item.itemKey], coverLoaded: loadedCovers[item.itemKey]}}" />
    </view></view>
    <view wx:else class="home-state campus-panel"><text class="campus-muted">{{feedLoading ? '正在加载商品…' : (feedError || (searchEmpty ? '没有找到相关商品' : '暂时没有在售商品'))}}</text>
      <button wx:if="{{feedError}}" class="campus-secondary" bindtap="retryFeed">重新加载</button></view>
    <view class="discovery-heading"><text class="discovery-title">热门服务</text><text class="discovery-link" aria-role="button" bindtap="onKingkongTap" data-type="local">全部服务 ›</text></view>
    <view class="popular-services"><view class="popular-link" wx:for="{{hotServices}}" wx:key="id" data-type="{{item.type}}" bindtap="onHotServiceTap" aria-role="button"><text class="popular-label">{{item.title}} ›</text></view></view>
    <view class="discover-actions"><text class="discovery-link" aria-role="button" bindtap="openPublish">发布商品</text><text class="discovery-link" aria-role="button" bindtap="openMessages">交易消息</text></view>
  </view>
</view>
