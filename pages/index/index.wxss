/* 搜索面板 */
.search-panel { position:fixed; top:0; left:0; right:0; bottom:0; z-index:200; }
.search-panel-mask { position:absolute; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.24); }
.search-panel-content { position:absolute; top:112rpx; left:0; right:0; box-sizing:border-box; background:#FFF; padding:20rpx 24rpx 28rpx; max-height:64vh; overflow-y:auto; border-radius:0 0 24rpx 24rpx; box-shadow:0 12rpx 28rpx rgba(0,0,0,0.12); }
.panel-heading { display:flex; align-items:center; justify-content:space-between; margin-bottom:12rpx; }
.panel-title { font-size:26rpx; font-weight:600; color:#333; }
.panel-count { font-size:22rpx; color:#999; }
.suggest-list { display:flex; flex-direction:column; gap:4rpx; }
.suggest-item { display:flex; align-items:center; gap:12rpx; min-height:72rpx; box-sizing:border-box; padding:14rpx 12rpx; font-size:26rpx; color:#333; border-radius:10rpx; }
.suggest-item:active { background:#F5F5F5; }
.suggest-icon { font-size:24rpx; color:#999; }
.suggest-empty { padding:24rpx; text-align:center; font-size:24rpx; color:#999; }
.hot-tags { display:flex; flex-wrap:wrap; gap:12rpx; }
.hot-tag { padding:12rpx 24rpx; background:#FFF3E8; color:#FF6B35; font-size:24rpx; border-radius:24rpx; }
.hot-tag:active { opacity:0.7; }
.history-list { display:flex; flex-wrap:wrap; gap:12rpx; }
.history-item { padding:10rpx 20rpx; background:#F5F5F5; color:#666; font-size:24rpx; border-radius:16rpx; }
.history-clear { padding:10rpx 20rpx; color:#4A90D9; font-size:22rpx; }
/* 推荐 */
.recommend-scroll { white-space:nowrap; padding:0 24rpx; }
.recommend-card { display:inline-flex; flex-direction:column; width:220rpx; box-sizing:border-box; overflow:hidden; background:#FFF; border-radius:12rpx; padding:16rpx; margin-right:16rpx; box-shadow:0 2rpx 8rpx rgba(0,0,0,0.05); }
.recommend-img { width:100%; height:140rpx; border-radius:8rpx; display:flex; align-items:center; justify-content:center; font-size:48rpx; margin-bottom:8rpx; }
.recommend-img image { width:100%; height:100%; display:block; border-radius:8rpx; }
.recommend-title { font-size:24rpx; color:#333; margin-bottom:4rpx; line-height:1.4; }
.recommend-card .text-price { width:100%; font-size:28rpx; }
.recommend-tag { font-size:18rpx; color:#4A90D9; background:#EBF3FC; padding:2rpx 10rpx; border-radius:6rpx; margin-top:4rpx; display:inline-block; width:fit-content; }
.search-area {
  position: relative;
  z-index: 202;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
}

.search-bar {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  padding: 0 24rpx;
  border: 2rpx solid transparent;
  border-radius: 40rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.search-bar-active {
  border-color: #4A90D9;
  box-shadow: 0 4rpx 16rpx rgba(74, 144, 217, 0.18);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  height: 68rpx;
  font-size: 28rpx;
  color: #333333;
  min-width: 0;
}

.search-placeholder {
  color: #A8ADB5;
}

.search-clear {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background-color: #CCCCCC;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.search-clear text {
  font-size: 20rpx;
  color: #FFFFFF;
  line-height: 1;
}

.search-cancel {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #4A90D9;
}

/* 搜索无结果 */
.search-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.search-empty text:first-child {
  font-size: 64rpx;
  margin-bottom: 20rpx;
}

.search-empty text:last-child {
  font-size: 28rpx;
  color: #999999;
}

/* 金刚区 */
.kingkong-section {
  background-color: #FFFFFF;
  margin: 0 24rpx;
  border-radius: 20rpx;
  padding: 28rpx 8rpx 24rpx;
  box-shadow: 0 6rpx 22rpx rgba(32, 45, 64, 0.06);
}

.kingkong-row {
  display: flex;
  justify-content: space-around;
}

.kingkong-row:first-child {
  margin-bottom: 24rpx;
}

.kingkong-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 25%;
}

.kingkong-item:active .kingkong-icon {
  transform: scale(0.92);
}

.kingkong-icon {
  width: 96rpx;
  height: 96rpx;
  box-sizing: border-box;
  border-radius: 30rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.86);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.72), 0 5rpx 12rpx rgba(45, 68, 98, 0.08);
  transition: transform 0.16s ease;
}

.kingkong-icon-image {
  width: 62rpx;
  height: 62rpx;
}

.kingkong-text {
  font-size: 25rpx;
  line-height: 1.4;
  color: #2F3542;
  font-weight: 500;
}

/* 区块标题 */
.section-header {
  padding: 28rpx 24rpx 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

/* 热门服务：固定三个并铺满一行 */
.hot-service-grid {
  display: flex;
  gap: 16rpx;
  padding: 0 24rpx;
}

.hot-service-card {
  display: flex;
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
  flex-direction: column;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 12rpx;
  padding: 24rpx 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.hot-service-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-bottom: 12rpx;
}

.hot-service-title {
  width: 100%;
  font-size: 26rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 信息流列表 */
.info-list {
  padding: 0 24rpx;
}

.info-item {
  margin: 0 0 16rpx 0;
}

.info-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.info-img image {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 12rpx;
}

.info-content {
  flex: 1;
  min-width: 0;
}

.info-title {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 8rpx;
  line-height: 1.5;
}

.info-meta {
  min-width: 0;
  margin-bottom: 8rpx;
}

.info-meta .text-price {
  max-width: 58%;
}

.info-footer {
  gap: 12rpx;
}

.info-tag {
  font-size: 20rpx;
  color: #4A90D9;
  background-color: #E8F4FD;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}
.safety-announcement { display:flex; min-height:54rpx; padding:0 24rpx; align-items:center; background:#FFF7E8; color:#8A682E; font-size:21rpx; }
.safety-announcement-icon { display:flex; width:28rpx; height:28rpx; margin-right:10rpx; align-items:center; justify-content:center; border-radius:50%; background:#E9B458; color:#FFF; font-size:18rpx; font-weight:700; }
.safety-announcement-arrow { margin-left:auto; color:#B58C47; font-size:30rpx; }

.home-brand { display: flex; min-height: 48px; margin: 8px 16px 2px; align-items: center; justify-content: space-between; }
.home-entry,.home-state,.home-safety { margin: 12px 16px; } .home-entry { box-sizing: border-box; }
.home-safety,.home-state { display: flex; align-items: center; justify-content: space-between; gap: 8px; } .home-state { padding: 20px 12px; }
.home-link { display: inline-flex; align-items: center; min-height: 44px; color: #215B98; font-size: 13px; }
.section-header { padding: 0 16px; min-height: 48px; display: flex; align-items: center; }
.search-area { padding: 0 16px; background: transparent; } .search-bar { min-height: 48px; border: 1px solid #D9E3EA; border-radius: 12px; }
.kingkong-section { margin: 0 16px; border-radius: 16px; background: #fff; }

.home-logo { width: 37px; height: 37px; margin-right: 9px; border-radius: 10px; } .home-brand .campus-muted { margin-left: auto; }
.search-panel-content { top: 110px; }
