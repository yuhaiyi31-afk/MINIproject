<view class="services-header"><view class="services-heading"><text class="campus-h1">服务大厅</text><button class="campus-primary" bindtap="onPublishTap">发布服务</button></view>
<view class="service-groups"><view class="service-group {{index === 1 ? 'service-group-middle' : ''}}" wx:for="{{groups}}" wx:key="label" bindtap="chooseGroup" data-index="{{index}}" aria-role="button">
  <image class="service-group-icon" src="/assets/icons/home/{{item.icon}}.svg" mode="aspectFit"/><text class="service-group-label">{{item.label}}</text><text class="service-group-detail">{{item.detail}}</text>
</view></view></view>
<!-- 顶部分类Tab -->
<scroll-view class="category-tabs" scroll-x>
  <view class="tab-item {{currentTab === 8 ? 'tab-active' : ''}}" bindtap="showAll">全部</view>
  <view wx:if="{{index < 8}}" class="tab-item {{currentTab === index ? 'tab-active' : ''}}" 
        wx:for="{{tabs}}" wx:key="*this" 
        bindtap="onTabChange" data-index="{{index}}">
    {{item}}
  </view>
</scroll-view>

<!-- 服务卡片列表 -->
<view class="service-list">
  <view class="service-card card" wx:for="{{filteredList}}" wx:key="itemKey" bindtap="onServiceTap" data-item="{{item}}">
    <view class="flex-between" style="margin-bottom: 12rpx;">
      <view class="flex-row" style="gap: 12rpx;">
        <view class="service-icon" style="background: {{item.bgColor}};">
          <image wx:if="{{item.images && item.images.length > 0}}" class="service-cover" src="{{item.images[0]}}" mode="aspectFill" lazy-load fade-show></image>
          <text wx:else>{{item.icon}}</text>
        </view>
        <text class="service-title text-ellipsis">{{item.title}}</text>
      </view>
      <view class="service-tags-row">
        <text class="service-tag">{{item.tag}}</text>
      </view>
    </view>
    <text class="service-desc text-ellipsis-2">{{item.desc}}</text>

    <view class="flex-between" style="margin-top: 16rpx;">
      <view class="flex-row" style="gap:8rpx;">
        <text class="service-contact">站内联系</text>
        <text class="badge-promise" wx:if="{{item.isPromise}}">🤝 承诺真实</text>
      </view>
      <text class="text-muted">{{item.time}}</text>
    </view>
  </view>
</view>

<view class="empty-tip" wx:if="{{filteredList.length === 0}}">
  <text class="text-muted">{{loading ? '正在读取真实信息…' : (errorText || '暂无相关服务信息')}}</text>
  <button wx:if="{{errorText}}" class="campus-secondary" bindtap="retryServices">重新加载</button>
  <view wx:elif="{{!loading}}" class="empty-publish-btn" bindtap="onPublishTap" data-type="{{tabs[currentTab]}}">
    <text>发布服务</text>
  </view>
</view>

