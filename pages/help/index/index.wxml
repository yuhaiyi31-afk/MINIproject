<!-- 顶部分类Tab -->
<scroll-view class="category-tabs" scroll-x>
  <view class="tab-item {{currentTab === index ? 'tab-active' : ''}}" 
        wx:for="{{tabs}}" wx:key="index" 
        bindtap="onTabChange" data-index="{{index}}">
    {{item}}
  </view>
</scroll-view>

<!-- 服务卡片列表 -->
<view class="service-list">
  <view class="service-card card" wx:for="{{filteredList}}" wx:key="id" bindtap="onServiceTap" data-id="{{item.id}}">
    <view class="flex-between" style="margin-bottom: 12rpx;">
      <view class="flex-row" style="gap: 12rpx;">
        <view class="service-icon" style="background: {{item.bgColor}};">
          <text>{{item.icon}}</text>
        </view>
        <text class="service-title text-ellipsis">{{item.title}}</text>
      </view>
      <text class="service-tag">{{item.tag}}</text>
    </view>
    <text class="service-desc text-ellipsis-2">{{item.desc}}</text>
    <view class="flex-between" style="margin-top: 16rpx;">
      <text class="service-contact">📞 {{item.contact}}</text>
      <text class="text-muted">{{item.time}}</text>
    </view>
  </view>
</view>

<!-- 底部提示 -->
<view class="load-more text-muted" wx:if="{{filteredList.length > 0}}">— 上拉加载更多 —</view>
<view class="empty-tip" wx:else>
  <text class="text-muted">暂无相关服务信息</text>
</view>

<!-- 悬浮发布按钮 -->
<view class="fab-btn" bindtap="onPublishTap">
  <text class="fab-icon">＋</text>
  <text class="fab-text">发布</text>
</view>
