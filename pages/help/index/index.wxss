/* 分类Tab */
.category-tabs {
  background-color: #FFFFFF;
  white-space: nowrap;
  padding: 16rpx 24rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: #666666;
  border-radius: 30rpx;
  margin-right: 16rpx;
  background-color: #F5F5F5;
}

.tab-active {
  color: #FFFFFF;
  background-color: #4A90D9;
  font-weight: 500;
}

/* 服务卡片 */
.service-list {
  padding: 0 24rpx;
}

.service-card {
  margin: 16rpx 0;
}

.service-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
  overflow: hidden;
}

.service-cover {
  width: 100%;
  height: 100%;
  display: block;
}

.service-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333333;
  max-width: 380rpx;
}

.service-tags-row {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.service-tag {
  font-size: 22rpx;
  color: #4A90D9;
  background-color: #E8F4FD;
  padding: 4rpx 14rpx;
  border-radius: 4rpx;
  flex-shrink: 0;
}

.service-desc {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
}

.service-contact {
  font-size: 24rpx;
  color: #666666;
}

/* 发布者真实性承诺 */
.badge-promise {
  font-size: 20rpx;
  color: #4CAF50;
  background: #E8F5E9;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  white-space: nowrap;
}

/* 拼车座位 */
.carpool-seats {
  margin-top: 12rpx;
  padding: 8rpx 14rpx;
  background: #E0F7FA;
  border-radius: 8rpx;
  display: inline-block;
}
.seats-label { font-size: 22rpx; color: #00838F; }
.seats-num { font-weight: 700; color: #FF6B35; }

/* 悬浮发布按钮 */
.fab-btn {
  position: fixed;
  right: 32rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #4A90D9, #6BA5E7);
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(74, 144, 217, 0.4);
  z-index: 100;
}

.fab-icon {
  font-size: 36rpx;
  font-weight: 300;
  line-height: 1;
}

.fab-text {
  font-size: 18rpx;
  margin-top: -2rpx;
}


.empty-tip {
  text-align: center;
  padding: 100rpx 0;
}

.empty-publish-btn {
  margin-top: 24rpx;
  padding: 16rpx 40rpx;
  background: #4A90D9;
  border-radius: 30rpx;
  display: inline-block;
}

.empty-publish-btn text {
  font-size: 26rpx;
  color: #FFFFFF;
}

.services-header { padding: 8px 16px 0; } .services-heading { min-height: 48px; display: flex; justify-content: space-between; align-items: center; }
.category-tabs { position: relative; top: auto; padding: 4px 16px; box-sizing: border-box; } .tab-item { min-height: 44px; line-height: 44px; padding: 0 12px; }
.service-list { padding: 4px 16px; } .service-card { margin: 8px 0; padding: 14px; border: 1px solid #D9E3EA; border-radius: 16px; } .service-title { color: #172E43; }
