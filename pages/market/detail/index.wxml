<view class="detail-status" wx:if="{{loading}}">
  <text>正在读取真实发布…</text>
</view>

<view class="detail-status" wx:elif="{{loadError}}">
  <text class="detail-status-title">暂时无法查看</text>
  <text class="detail-status-text">{{loadError}}</text>
</view>

<view class="detail-page" wx:else>
  <!-- 商品媒体 -->
  <view class="media-section" wx:if="{{item.videoPath || (item.images && item.images.length)}}">
    <video
      wx:if="{{item.videoPath && videoActivated}}"
      class="detail-video-player"
      src="{{item.videoPath}}"
      poster="{{item.images && item.images.length ? item.images[0] : ''}}"
      controls
      autoplay
      object-fit="contain"
    ></video>

    <view
      wx:elif="{{item.videoPath}}"
      class="detail-video-placeholder"
      bindtap="onActivateVideo"
    >
      <image
        wx:if="{{item.images && item.images.length}}"
        class="detail-video-poster"
        src="{{item.images[0]}}"
        mode="aspectFill"
        lazy-load
      ></image>
      <view class="detail-video-mask"></view>
      <view class="detail-video-play">
        <text class="detail-video-play-icon">▶</text>
        <text class="detail-video-play-text">播放视频</text>
      </view>
    </view>

    <swiper
      wx:if="{{item.images && item.images.length > 0}}"
      class="detail-swiper"
      current="{{currentImageIndex}}"
      bindchange="onSwiperChange"
    >
      <swiper-item wx:for="{{item.images}}" wx:key="*this">
        <image
          class="swiper-img"
          src="{{item}}"
          mode="aspectFit"
          data-src="{{item}}"
          bindtap="onPreviewImage"
        ></image>
      </swiper-item>
    </swiper>

    <view class="image-counter" wx:if="{{item.images && item.images.length > 1}}">
      {{currentImageIndex + 1}} / {{item.images.length}}
    </view>
  </view>

  <!-- 商品信息 -->
  <view class="product-card">
    <view class="price-row">
      <view class="detail-price" wx:if="{{item.price > 0}}">
        <text class="price-symbol">NZ$</text>
        <text class="price-value">{{item.priceText || item.price}}</text>
      </view>
      <text class="detail-price free-price" wx:else>免费</text>
      <view class="product-pills">
        <text class="status-pill {{item.status}}">{{item.status === 'sold' ? '已售' : (item.status === 'unlisted' ? '已下架' : (item.status === 'suspended' ? '平台暂停' : '在售'))}}</text>
        <text class="category-pill" wx:if="{{item.category}}">{{item.category}}</text>
      </view>
    </view>

    <text class="detail-title">{{item.title}}</text>

    <view class="description-block" wx:if="{{showDescription}}">
        <text class="section-label">{{item.itemType === 'service' ? '信息描述' : '商品描述'}}</text>
      <text class="detail-desc">{{item.description}}</text>
    </view>

    <view class="product-facts" wx:if="{{item.itemType !== 'service'}}">
      <view class="fact-row"><text class="fact-label">新旧程度</text><text class="fact-value">{{item.condition || '卖家暂未补充'}}</text></view>
      <view class="fact-row"><text class="fact-label">大概地区</text><text class="fact-value">{{item.region || '卖家暂未补充'}}</text></view>
      <view class="fact-row"><text class="fact-label">交付方式</text><text class="fact-value">{{item.deliveryMethod || '双方协商'}}</text></view>
    </view>

    <view class="meta-row">
      <text>发布于 {{item.time || '刚刚'}}</text>
      <text wx:if="{{item.subCategory}}">{{item.subCategory}}</text>
    </view>
  </view>

  <!-- 卖家信息 -->
  <view class="detail-card seller-card">
    <text class="card-heading">{{item.itemType === 'service' ? '发布者' : '卖家'}}</text>
    <view class="seller-content">
      <image
        wx:if="{{sellerAvatarUrl}}"
        class="seller-avatar-image"
        src="{{sellerAvatarUrl}}"
        mode="aspectFill"
      ></image>
      <view wx:else class="seller-avatar-fallback">
        <text>{{sellerInitial}}</text>
      </view>
      <view class="seller-copy">
        <text class="seller-name">{{sellerName}}</text>
        <text class="seller-note">{{isOwner ? '这是你自己发布的内容' : '通过小程序联系' + (item.itemType === 'service' ? '发布者' : '卖家')}}{{item.sellerType === 'BUSINESS' ? ' · 商业卖家' : ' · 私人卖家'}}</text>
      </view>
      <button class="seller-chat-btn" bindtap="onStartChat" loading="{{chatBusy}}" disabled="{{chatBusy}}" wx:if="{{ownershipResolved && !isOwner}}">聊一聊</button>
    </view>
  </view>

  <!-- 交易安全 -->
  <view class="detail-card buyer-protect">
    <view class="protect-header">
      <view class="protect-icon">盾</view>
      <view>
      <text class="protect-title">{{item.itemType === 'service' ? '服务安全提示' : '交易安全提示'}}</text>
      <text class="protect-subtitle">{{item.itemType === 'service' ? '确认服务内容后再付款' : '当面确认商品后再付款'}}</text>
      </view>
    </view>
    <view class="protect-list">
      <text class="protect-required">禁止违法交易。平台不代收款，请验货后付款，勿提前转账，谨防诈骗。</text>
      <view class="protect-item"><view class="protect-dot"></view><text>选择公共场所当面交易</text></view>
      <view class="protect-item"><view class="protect-dot"></view><text>{{item.itemType === 'service' ? '核实服务信息，保留聊天和付款记录' : '仔细检查物品，保留聊天和付款记录'}}</text></view>
      <view class="protect-item"><view class="protect-dot"></view><text>发现异常时停止交易并举报</text></view>
    </view>
  </view>

  <view class="detail-secondary" wx:if="{{!isOwner}}">
    <text bindtap="onShowReport">举报商品</text>
    <text class="secondary-divider">·</text>
    <text bindtap="onShowUserReport">举报卖家</text>
    <text class="secondary-divider">·</text>
    <text bindtap="onToggleBlockSeller">{{sellerBlocked ? '取消拉黑' : '拉黑卖家'}}</text>
  </view>
  <view class="detail-secondary" wx:else>
    <text bindtap="onOpenOwnManage">前往“我的发布”管理或删除商品</text>
  </view>

  <!-- 底部操作栏 -->
  <view class="detail-bottom-bar" wx:if="{{ownershipResolved}}">
    <block wx:if="{{isOwner}}">
      <button class="primary-action owner-edit-action" bindtap="onEditOwnItem" disabled="{{ownerActionBusy}}">编辑发布</button>
      <button class="primary-action owner-unlist-action" bindtap="onUnlistOwnItem" loading="{{ownerActionBusy}}" disabled="{{ownerActionBusy}}" wx:if="{{item.status === 'active'}}">下架</button>
      <button class="primary-action owner-sold-action" bindtap="onMarkSoldOwnItem" loading="{{ownerActionBusy}}" disabled="{{ownerActionBusy}}" wx:if="{{item.status === 'active' && item.itemType !== 'service'}}">标记已售</button>
      <button class="primary-action owner-relist-action" bindtap="onRelistOwnItem" loading="{{ownerActionBusy}}" disabled="{{ownerActionBusy}}" wx:if="{{item.status === 'unlisted' || item.status === 'sold'}}">重新上架</button>
    </block>
    <block wx:else>
      <button class="favorite-action {{isFavorited ? 'favorite-active' : ''}}" bindtap="onToggleFavorite">
        <text class="favorite-icon">{{isFavorited ? '♥' : '♡'}}</text>
        <text>{{isFavorited ? '已收藏' : '收藏'}}</text>
      </button>
      <button class="primary-action chat-action" bindtap="onStartChat" loading="{{chatBusy}}" disabled="{{chatBusy}}">聊一聊</button>
      <button class="primary-action buy-action" bindtap="onWantBuy">{{item.itemType === 'service' ? '我需要' : '我想要'}}</button>
    </block>
  </view>
</view>

<!-- 举报弹窗 -->
<view class="report-modal" wx:if="{{showReport}}" catchtap="onCloseReport">
  <view class="report-content" catchtap="noop">
    <text class="report-title">{{reportTargetType === 'user' ? '举报卖家' : '举报商品'}}</text>
    <text class="report-tip">请选择举报原因，平台会保留记录并由管理员处理</text>
    <picker mode="selector" range="{{reportReasons}}" bindchange="onSelectReason">
      <view class="report-picker">{{reportReasons[reasonIdx]}}</view>
    </picker>
    <textarea
      class="report-input"
      placeholder="补充说明（选填）"
      value="{{reportDetail}}"
      bindinput="onReportInput"
      maxlength="200"
    />
    <view class="report-btns">
      <button class="report-cancel" bindtap="onCloseReport">取消</button>
      <button class="report-submit" bindtap="onSubmitReport" loading="{{reportBusy}}" disabled="{{reportBusy}}">提交举报</button>
    </view>
  </view>
</view>
