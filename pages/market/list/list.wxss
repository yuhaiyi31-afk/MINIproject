page { background:#F4F6F8; }

.market-tools { padding:18rpx 24rpx 12rpx; background:#FFF; }
.market-search { height:72rpx; display:flex; align-items:center; padding:0 20rpx; border-radius:38rpx; background:#F3F5F7; }
.market-search-icon { color:#7E8794; font-size:34rpx; line-height:1; }
.market-search-input { flex:1; min-width:0; height:72rpx; margin-left:12rpx; color:#273142; font-size:27rpx; }
.market-search-clear { width:48rpx; color:#9AA2AE; font-size:34rpx; text-align:center; }
.category-scroll { width:100%; margin-top:18rpx; white-space:nowrap; }
.category-row { display:flex; gap:12rpx; padding-bottom:4rpx; }
.category-chip { display:inline-flex; flex-shrink:0; height:54rpx; padding:0 22rpx; align-items:center; border-radius:28rpx; background:#F3F5F7; color:#626C79; font-size:23rpx; }
.category-chip.active { background:#E7F1FC; color:#3478C9; font-weight:600; }
.filter-bar { display:flex; align-items:center; justify-content:space-between; margin-top:18rpx; }
.result-hint { color:#9098A4; font-size:21rpx; }
.filter-btn { display:flex; height:52rpx; padding:0 18rpx; align-items:center; border-radius:28rpx; background:#F3F5F7; color:#5E6875; font-size:22rpx; }
.filter-btn-on { background:#E7F1FC; color:#3478C9; }
.filter-arrow { margin-left:8rpx; font-size:16rpx; }

.filter-panel { margin:16rpx 24rpx; padding:24rpx; }
.filter-row { display:flex; align-items:center; justify-content:space-between; margin-bottom:20rpx; }
.filter-label { margin-right:18rpx; flex-shrink:0; color:#505A68; font-size:24rpx; }
.filter-price-row { display:flex; flex:1; align-items:center; justify-content:flex-end; }
.filter-input { width:150rpx; height:60rpx; padding:0 12rpx; box-sizing:border-box; border-radius:10rpx; background:#F4F6F8; color:#303947; font-size:24rpx; text-align:center; }
.filter-separator { margin:0 10rpx; color:#A2A9B2; }
.filter-picker { max-width:360rpx; padding:13rpx 18rpx; overflow:hidden; border-radius:10rpx; background:#F4F6F8; color:#303947; font-size:23rpx; text-overflow:ellipsis; white-space:nowrap; }
.nearby-hint { display:block; margin:-4rpx 0 18rpx; color:#8A94A3; font-size:21rpx; line-height:1.5; }
.filter-actions { display:flex; gap:14rpx; }
.filter-apply,.filter-clear { flex:1; height:68rpx; margin:0; padding:0; border-radius:36rpx; font-size:24rpx; line-height:68rpx; }
.filter-apply { background:#4A90D9; color:#FFF; }
.filter-clear { background:#EFF2F5; color:#626C79; }


.market-tools { padding: 8px 16px 0; }
.market-heading,.feed-state { display: flex; align-items: center; }
.market-heading { justify-content: space-between; padding-bottom: 12px; }
.market-search { height: 48px; border-radius: 12px; background: #F4F7F9; border: 1px solid #D9E3EA; }
.market-search-input,.market-search-clear { height: 44px; line-height: 44px; }
.market-search-clear { min-width: 44px; }
.market-search-icon { color: #526778; font-size: 13px; }
.category-chip { height: 44px; padding: 0 13px; font-size: 13px; }
.category-chip.active { color: #215B98; background: #E8F2FC; }
.filter-bar { margin: 4px 0 12px; min-height: 44px; }
.filter-btn,.filter-apply,.filter-clear,.filter-picker,.filter-input { min-height: 44px; box-sizing: border-box; }
.filter-apply,.filter-clear { line-height: 44px; border-radius: 12px; }
.filter-apply { background: #215B98; }
.filter-picker { display: flex; align-items: center; }
.result-hint,.filter-label,.nearby-hint { color: #526778; font-size: 13px; }
.filter-panel { margin: 0 16px 12px; }
.feed-state { flex-direction: column; gap: 12px; text-align: center; }
