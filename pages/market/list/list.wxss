/* 分类Tab */
.category-tabs {
  background-color: #FFFFFF;
  white-space: nowrap;
  padding: 16rpx 24rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: #666666;
  border-radius: 30rpx;
  margin-right: 16rpx;
  background-color: #F5F5F5;
}

.tab-active {
  color: #FFFFFF;
  background-color: #4A90D9;
  font-weight: 500;
}

/* 物品列表 */
.item-list {
  padding: 0 24rpx;
}

.item-card {
  margin: 16rpx 0;
}

.item-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  min-width: 0;
}

.item-title {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.5;
}

.item-avatar {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background-color: #E8F4FD;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
}

/* 悬浮发布按钮 */
.fab-btn {
  position: fixed;
  right: 32rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #4A90D9, #6BA5E7);
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(74, 144, 217, 0.4);
  z-index: 100;
}

.fab-icon {
  font-size: 36rpx;
  font-weight: 300;
  line-height: 1;
}

.fab-text {
  font-size: 18rpx;
  margin-top: -2rpx;
}

.load-more {
  text-align: center;
  padding: 30rpx 0;
}

.empty-tip {
  text-align: center;
  padding: 100rpx 0;
}
