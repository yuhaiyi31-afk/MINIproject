<view class="market-tools">
  <view class="market-search">
    <text class="market-search-icon">⌕</text>
    <input
      class="market-search-input"
      value="{{keyword}}"
      placeholder="搜索二手商品"
      confirm-type="search"
      maxlength="60"
      bindinput="onKeywordInput"
      bindconfirm="onSearchConfirm"
    />
    <text class="market-search-clear" wx:if="{{keyword}}" bindtap="onClearKeyword">×</text>
  </view>

  <scroll-view class="category-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
    <view class="category-row">
      <text
        class="category-chip {{categoryIdx === index ? 'active' : ''}}"
        wx:for="{{categoryOptions}}"
        wx:key="*this"
        data-index="{{index}}"
        bindtap="onCategoryTap"
      >{{item}}</text>
    </view>
  </scroll-view>

  <view class="filter-bar">
    <text class="result-hint">{{items.length}} 件在售商品</text>
    <view class="filter-btn {{filterActive ? 'filter-btn-on' : ''}}" bindtap="onToggleFilter">
      <text>筛选与排序</text>
      <text class="filter-arrow">{{showFilter ? '▲' : '▼'}}</text>
    </view>
  </view>
</view>

<view class="filter-panel card" wx:if="{{showFilter}}">
  <view class="filter-row">
    <text class="filter-label">价格区间 NZ$</text>
    <view class="filter-price-row">
      <input class="filter-input" type="digit" placeholder="最低" value="{{filterMinPrice}}" bindinput="onFilterMinPrice"/>
      <text class="filter-separator">—</text>
      <input class="filter-input" type="digit" placeholder="最高" value="{{filterMaxPrice}}" bindinput="onFilterMaxPrice"/>
    </view>
  </view>
  <view class="filter-row">
    <text class="filter-label">大概地区</text>
    <picker mode="selector" range="{{regionOptions}}" value="{{regionIdx}}" bindchange="onRegionChange">
      <view class="filter-picker">{{regionOptions[regionIdx]}}</view>
    </picker>
  </view>
  <view class="filter-row">
    <text class="filter-label">发布时间</text>
    <picker mode="selector" range="{{timeOptions}}" value="{{filterTimeIdx}}" bindchange="onFilterTime">
      <view class="filter-picker">{{timeOptions[filterTimeIdx]}}</view>
    </picker>
  </view>
  <view class="filter-row">
    <text class="filter-label">排序方式</text>
    <picker mode="selector" range="{{sortOptions}}" value="{{sortIdx}}" bindchange="onSortChange">
      <view class="filter-picker">{{sortOptions[sortIdx]}}</view>
    </picker>
  </view>
  <text class="nearby-hint" wx:if="{{sortIdx === 1}}">附近排序只使用你选择的大概地区，不读取或保存精确位置。</text>
  <view class="filter-actions">
    <button class="filter-clear" bindtap="onClearFilter">清除</button>
    <button class="filter-apply" bindtap="onApplyFilter">查看结果</button>
  </view>
</view>

<view class="item-list">
  <view class="item-card card" wx:for="{{items}}" wx:key="itemKey" bindtap="onItemTap" data-item="{{item}}">
    <view class="item-img">
      <image class="item-cover" wx:if="{{item.images && item.images.length}}" src="{{item.images[0]}}" mode="aspectFill" lazy-load fade-show></image>
      <view class="item-cover-empty" wx:else>暂无图片</view>
      <text class="status-badge">在售</text>
    </view>
    <view class="item-info">
      <text class="item-title text-ellipsis-2">{{item.title}}</text>
      <text class="text-price">{{item.price > 0 ? 'NZ$ ' + (item.priceText || item.price) : '免费'}}</text>
      <view class="item-meta-row">
        <text class="item-region">{{item.region || '地区待补充'}}</text>
        <text class="item-time">{{item.time}}</text>
      </view>
      <view class="item-seller-row">
        <image class="item-avatar" wx:if="{{item.publisherAvatar}}" src="{{item.publisherAvatar}}" mode="aspectFill" lazy-load fade-show></image>
        <text class="item-seller">{{item.nickname}}</text>
        <text class="seller-type" wx:if="{{item.sellerType === 'BUSINESS'}}">商家</text>
      </view>
    </view>
  </view>
</view>

<view class="empty-tip" wx:if="{{!loading && items.length === 0}}">
  <text class="text-muted">{{emptyText}}</text>
</view>

<view class="fab-btn" bindtap="onPublishTap">
  <text class="fab-icon">＋</text>
  <text class="fab-text">发布</text>
</view>
