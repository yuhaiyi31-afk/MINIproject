<import src="../../../templates/listing-card.wxml" />
<view class="discovery">
  <view class="catalog-header">
    <view class="catalog-heading"><text class="catalog-title">二手集市</text><view class="catalog-publish" bindtap="onPublishTap" aria-role="button"><text class="catalog-publish-label">发布商品</text></view></view>
    <view class="catalog-search">
      <view class="catalog-loupe"><view class="catalog-loupe-ring"></view><view class="catalog-loupe-stem"></view></view>
      <input class="catalog-field" value="{{keyword}}" placeholder="搜索二手商品" maxlength="60" bindinput="onKeywordInput" bindconfirm="onSearchConfirm" confirm-type="search" />
      <text wx:if="{{keyword}}" class="catalog-clear" aria-role="button" aria-label="清空搜索" bindtap="onClearKeyword">×</text><text class="catalog-submit" aria-role="button" bindtap="onSearchConfirm">搜索</text>
    </view>
    <scroll-view class="catalog-categories" scroll-x enable-flex show-scrollbar="{{false}}"><view class="catalog-rail">
      <text wx:for="{{categoryOptions}}" wx:key="*this" class="catalog-chip {{categoryIdx === index ? 'catalog-chip-selected' : ''}}" data-index="{{index}}" bindtap="onCategoryTap">{{item}}</text>
    </view></scroll-view>
    <view class="catalog-results"><text class="catalog-count">已显示 {{items.length}} 件</text><text class="catalog-filter" aria-role="button" bindtap="onToggleFilter">{{showFilter ? '收起筛选' : (filterActive ? '已筛选' : '筛选与排序')}}</text></view>
  </view>
  <view class="filter-panel card" wx:if="{{showFilter}}">
  <view class="filter-row">
    <text class="filter-label">价格区间 NZ$</text>
    <view class="filter-price-row">
      <input class="filter-input" type="digit" placeholder="最低" value="{{filterMinPrice}}" bindinput="onFilterMinPrice"/>
      <text class="filter-separator">—</text>
      <input class="filter-input" type="digit" placeholder="最高" value="{{filterMaxPrice}}" bindinput="onFilterMaxPrice"/>
    </view>
  </view>
  <view class="filter-row">
    <text class="filter-label">大概地区</text>
    <picker mode="selector" range="{{regionOptions}}" value="{{regionIdx}}" bindchange="onRegionChange">
      <view class="filter-picker">{{regionOptions[regionIdx]}}</view>
    </picker>
  </view>
  <view class="filter-row">
    <text class="filter-label">发布时间</text>
    <picker mode="selector" range="{{timeOptions}}" value="{{filterTimeIdx}}" bindchange="onFilterTime">
      <view class="filter-picker">{{timeOptions[filterTimeIdx]}}</view>
    </picker>
  </view>
  <view class="filter-row">
    <text class="filter-label">排序方式</text>
    <picker mode="selector" range="{{sortOptions}}" value="{{sortIdx}}" bindchange="onSortChange">
      <view class="filter-picker">{{sortOptions[sortIdx]}}</view>
    </picker>
  </view>
  <text class="nearby-hint" wx:if="{{sortIdx === 1}}">附近排序只使用你选择的大概地区，不读取或保存精确位置。</text>
  <view class="filter-actions">
    <button class="filter-clear" bindtap="onClearFilter">清除</button>
    <button class="filter-apply" bindtap="onApplyFilter">查看结果</button>
  </view>
</view>
  <view class="catalog-feed" wx:if="{{items.length}}"><view class="feed-grid"><view class="feed-cell" wx:for="{{items}}" wx:key="itemKey" bindtap="onItemTap" data-item="{{item}}" aria-role="button" aria-label="{{item.title}}，{{item.campusPrice}}">
    <template is="listing-card" data="{{item, coverFailed: failedCovers[item.itemKey], coverLoaded: loadedCovers[item.itemKey]}}" />
  </view></view></view>
  <view class="campus-state feed-state" wx:if="{{loading}}"><text class="campus-muted">正在加载商品…</text></view>
<view class="campus-state feed-state" wx:elif="{{loadFailed || !items.length}}">
  <text class="campus-body">{{emptyText}}</text>
  <button wx:if="{{loadFailed}}" class="campus-secondary" bindtap="onRetry">重新加载</button>
  <button wx:elif="{{filterActive || keyword}}" class="campus-secondary" bindtap="onResetSearch">查看全部商品</button>
  <button wx:else class="campus-secondary" bindtap="onPublishTap">发布商品</button>
</view>
  <text class="catalog-end" wx:if="{{items.length && !hasMore && !loading && !loadFailed}}">已经到底了</text>
</view>
