<!-- 顶部分类Tab -->
<scroll-view class="category-tabs" scroll-x>
  <view class="tab-item {{currentTab === index ? 'tab-active' : ''}}" 
        wx:for="{{tabs}}" wx:key="index" 
        bindtap="onTabChange" data-index="{{index}}">
    {{item}}
  </view>
</scroll-view>

<!-- 物品列表 -->
<view class="item-list">
  <view class="item-card card" wx:for="{{filteredList}}" wx:key="id" bindtap="onItemTap" data-id="{{item.id}}">
    <view class="flex-row">
      <view class="item-img" style="background: {{item.bgColor}};">
        <text>{{item.icon}}</text>
      </view>
      <view class="item-info flex-column">
        <text class="item-title text-ellipsis-2">{{item.title}}</text>
        <view class="flex-between" style="margin-top: 8rpx;">
          <text class="text-price">NZ$ {{item.price}}</text>
          <view class="flex-row" style="gap: 8rpx;">
            <text class="item-avatar">{{item.avatar}}</text>
            <text class="text-muted">{{item.nickname}} · {{item.time}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>

<!-- 底部提示 -->
<view class="load-more text-muted" wx:if="{{filteredList.length > 0}}">— 上拉加载更多 —</view>
<view class="empty-tip" wx:else>
  <text class="text-muted">暂无相关物品</text>
</view>

<!-- 悬浮发布按钮 -->
<view class="fab-btn" bindtap="onPublishTap">
  <text class="fab-icon">＋</text>
  <text class="fab-text">发布</text>
</view>
