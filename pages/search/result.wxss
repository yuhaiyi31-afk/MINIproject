/* 搜索栏 */
.search-result-bar {
  background: #FFFFFF;
  padding: 16rpx 24rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}
.search-result-input-row {
  display: flex;
  align-items: center;
  background: #F5F5F5;
  border-radius: 40rpx;
  padding: 0 24rpx;
  height: 72rpx;
}
.search-back {
  font-size: 32rpx;
  color: #333;
  margin-right: 16rpx;
}
.search-result-input {
  flex: 1;
  font-size: 28rpx;
}
.search-clear-inline {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #CCC;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #FFF;
}

/* 结果 */
.result-count { display:block; padding:16rpx 24rpx; font-size:24rpx; color:#999; }
.result-item { margin: 12rpx 24rpx; }
.result-img { width:140rpx; height:140rpx; border-radius:8rpx; display:flex; align-items:center; justify-content:center; font-size:56rpx; margin-right:20rpx; flex-shrink:0; }
.result-img image { width:100%; height:100%; display:block; border-radius:8rpx; }
.result-info { flex:1; min-width:0; }
.result-info .text-price { width:100%; }
.result-title { font-size:26rpx; color:#333; line-height:1.5; }
.result-relevance { font-size:20rpx; color:#4A90D9; }

.search-empty { display:flex; flex-direction:column; align-items:center; padding:120rpx 0 40rpx; }
.search-empty text:first-child { font-size:64rpx; margin-bottom:20rpx; }
.search-empty text:nth-child(2) { font-size:26rpx; color:#666; }
.search-empty-hint { font-size:22rpx; color:#999; margin-top:12rpx; }

/* 猜你想搜 */
.recommend-section {
  padding: 24rpx 24rpx 40rpx;
}
.recommend-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.recommend-icon {
  font-size: 28rpx;
  margin-right: 10rpx;
}
.recommend-title {
  font-size: 26rpx;
  color: #333;
  font-weight: 600;
}
.recommend-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.recommend-tag {
  padding: 12rpx 28rpx;
  background: #F0F0F0;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: #555;
  transition: all 0.2s;
}
.recommend-tag:active {
  background: #4A90D9;
  color: #FFF;
}
