/* 列表 */
.list-wrap { padding: 0 28rpx; }

.fav-card {
  margin: 16rpx 0;
  padding: 24rpx;
  border-radius: 18rpx;
}

.fav-icon {
  width: 88rpx; height: 88rpx;
  border-radius: 12rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.fav-icon image { width:100%; height:100%; border-radius:inherit; display:block; }

.fav-info { flex: 1; min-width: 0; }

.fav-title {
  font-size: 28rpx; color: #333;
  line-height: 1.5;
}

.fav-cat {
  font-size: 20rpx; color: #4A90D9;
  background: #EBF3FC;
  padding: 4rpx 12rpx; border-radius: 8rpx;
}

.text-price-sm { display:block; min-width:0; max-width:100%; overflow:hidden; font-size:24rpx; color:#FF6B35; font-weight:600; text-overflow:ellipsis; white-space:nowrap; }

.fav-remove {
  display: block;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #F0F0F0;
  text-align: right;
  font-size: 24rpx;
  color: #FF5252;
  padding-right: 4rpx;
}

/* 确认弹窗 */
.action-modal {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5); z-index: 999;
  display: flex; align-items: center; justify-content: center;
}

.action-modal-content {
  width: 580rpx; background: #FFF;
  border-radius: 24rpx; padding: 40rpx 36rpx 32rpx;
}

.action-modal-title {
  font-size: 32rpx; font-weight: 600; color: #333;
  text-align: center; display: block; margin-bottom: 20rpx;
}

.action-modal-desc {
  font-size: 26rpx; color: #666;
  text-align: center; display: block;
  margin-bottom: 32rpx; line-height: 1.7;
}

.login-modal-btns { display: flex; gap: 20rpx; }

.login-btn-cancel, .login-btn-confirm {
  flex: 1; height: 84rpx; line-height: 84rpx;
  font-size: 28rpx; border-radius: 16rpx;
  padding: 0; text-align: center; border: none;
}
.login-btn-cancel::after, .login-btn-confirm::after { border: none; }

.login-btn-cancel { background: #F5F5F5; color: #666; }
.login-btn-confirm { background: linear-gradient(135deg,#4A90D9,#6BA5E7); color: #FFF; font-weight: 500; }

/* 空态 */
.empty-tip {
  text-align: center; padding: 160rpx 0;
  display: flex; flex-direction: column; align-items: center;
}
