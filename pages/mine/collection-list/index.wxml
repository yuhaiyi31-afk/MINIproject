<view class="list-wrap">
  <view class="fav-card card" wx:for="{{list}}" wx:key="itemKey" bindtap="onItemTap" data-item="{{item}}">
    <view class="flex-row">
      <view class="fav-icon" style="background:{{item.bgColor || '#F5F5F5'}};">
        <image wx:if="{{item.images && item.images.length}}" src="{{item.images[0]}}" mode="aspectFill" lazy-load fade-show></image>
        <text wx:else>{{item.icon || '📦'}}</text>
      </view>
      <view class="fav-info flex-column">
        <text class="fav-title text-ellipsis">{{item.title}}</text>
        <view class="flex-row" style="gap:8rpx; margin-top:6rpx;">
          <text class="fav-cat">{{item.category}}</text>
          <text class="text-price-sm" wx:if="{{item.price > 0}}">NZ$ {{item.priceText || item.price}}</text>
          <text class="text-price-sm" wx:else>免费</text>
        </view>
        <text class="text-muted" style="margin-top:4rpx;">{{item.time || ''}}</text>
      </view>
    </view>
    <text class="fav-remove" bindtap="onRemoveFav" data-item="{{item}}" catchtap="onRemoveFav">❤️ 取消收藏</text>
  </view>
</view>

<view class="empty-tip" wx:if="{{list.length === 0}}">
  <text style="font-size:64rpx;">❤️</text>
  <text style="font-size:28rpx;color:#999;margin-top:16rpx;">暂无收藏</text>
  <text style="font-size:24rpx;color:#CCC;">去浏览感兴趣的内容吧</text>
</view>

<view class="action-modal" wx:if="{{showAction}}" catchtap="onCancelAction">
  <view class="action-modal-content" catchtap="noop">
    <text class="action-modal-title">取消收藏</text>
    <text class="action-modal-desc">确定要取消收藏"{{actionItem.title}}"吗？</text>
    <view class="login-modal-btns">
      <button class="login-btn-cancel" bindtap="onCancelAction">取消</button>
      <button class="login-btn-confirm" bindtap="onConfirmRemove" style="background:#FF5252;">确认</button>
    </view>
  </view>
</view>
