/* 用户信息区 */
.user-section {
  position: relative;
  padding: 40rpx 24rpx;
  overflow: hidden;
}

.user-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #4A90D9, #6BA5E7);
  border-radius: 0 0 40rpx 40rpx;
}

.user-info {
  position: relative;
  z-index: 1;
}

.user-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.3);
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-right: 24rpx;
}

.user-detail {
  flex: 1;
}

.user-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.user-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.user-arrow {
  font-size: 32rpx;
  color: #FFFFFF;
}

/* 功能菜单 */
.menu-section {
  margin: 24rpx 24rpx;
  padding: 0;
}

.menu-item {
  padding: 28rpx 24rpx;
}

.menu-icon {
  font-size: 32rpx;
}

.menu-text {
  font-size: 28rpx;
  color: #333333;
}

.menu-divider {
  height: 1rpx;
  background-color: #F0F0F0;
  margin: 0 24rpx;
}

/* 底部信息 */
.footer-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.footer-subtitle {
  font-size: 20rpx;
  color: #CCCCCC;
  margin-top: 8rpx;
}
