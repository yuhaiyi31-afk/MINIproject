/* 用户信息区 */
.user-section {
  position: relative;
  padding: 60rpx 32rpx 40rpx;
  overflow: hidden;
}

.user-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #4A90D9, #5BA0E8);
  border-radius: 0 0 48rpx 48rpx;
}

.user-info {
  position: relative;
  z-index: 1;
}

.user-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.3);
  border: 4rpx solid rgba(255, 255, 255, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  margin-right: 28rpx;
  flex-shrink: 0;
}

.user-avatar-frame {
  width: 120rpx;
  height: 120rpx;
  min-width: 120rpx;
  max-width: 120rpx;
  min-height: 120rpx;
  max-height: 120rpx;
  box-sizing: border-box;
  padding: 4rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 2rpx solid rgba(255, 255, 255, 0.72);
  box-shadow: 0 6rpx 18rpx rgba(27, 75, 122, 0.22);
  margin-right: 28rpx;
  flex: 0 0 120rpx;
  overflow: hidden;
}

.user-avatar-img {
  display: block;
  width: 100%;
  height: 100%;
  min-width: 100%;
  min-height: 100%;
  border-radius: 999rpx;
}

.user-detail {
  flex: 1;
}

.user-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 6rpx;
}

.user-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.user-register { margin-top:6rpx; color:rgba(255,255,255,.72); font-size:20rpx; }
.seller-stats { position:relative; z-index:1; display:flex; margin:28rpx 0 -12rpx; padding:18rpx 0; border-radius:18rpx; background:rgba(255,255,255,.14); }
.seller-stat { display:flex; flex:1; align-items:center; justify-content:center; flex-direction:column; }
.seller-stat-number { color:#FFF; font-size:30rpx; font-weight:700; }
.seller-stat-label { margin-top:4rpx; color:rgba(255,255,255,.78); font-size:20rpx; }
.seller-stat-divider { width:1rpx; background:rgba(255,255,255,.24); }

.account-warning {
  margin-top: 8rpx;
  color: #FFF0D8;
  font-size: 21rpx;
}

.user-arrow {
  font-size: 36rpx;
  color: #FFFFFF;
  margin-left: 12rpx;
}

/* 登录弹窗 */
.login-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-modal-content {
  width: 580rpx;
  max-height: 84vh;
  overflow-y: auto;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 44rpx 40rpx 36rpx;
}

.login-modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
  text-align: center;
  margin-bottom: 28rpx;
}

.phone-bind-card {
  display: flex;
  padding: 22rpx;
  align-items: center;
  border: 2rpx solid #D9E9FA;
  border-radius: 16rpx;
  background: #F5F9FE;
}

.phone-bind-card.bound {
  border-color: #CDEAD9;
  background: #F2FAF5;
}

.phone-bind-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}

.phone-bind-title {
  color: #26364A;
  font-size: 27rpx;
  font-weight: 600;
}

.phone-bind-desc {
  margin-top: 7rpx;
  overflow: hidden;
  color: #818A96;
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.phone-bind-btn {
  width: 146rpx;
  height: 64rpx;
  margin: 0 0 0 18rpx;
  padding: 0;
  border-radius: 32rpx;
  background: #07C160;
  color: #FFFFFF;
  font-size: 23rpx;
  line-height: 64rpx;
}

.phone-bind-btn::after { border: none; }

.phone-change-btn {
  background: #E5F4EB;
  color: #27834C;
}

.login-privacy-tip {
  display: block;
  margin: 12rpx 4rpx 24rpx;
  color: #A0A7B2;
  font-size: 20rpx;
  line-height: 1.45;
}

.login-avatar-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}

.avatar-btn {
  width: 140rpx;
  height: 140rpx;
  min-width: 140rpx;
  max-width: 140rpx;
  min-height: 140rpx;
  max-height: 140rpx;
  box-sizing: border-box;
  padding: 6rpx;
  margin: 0;
  border: 3rpx solid #D9E9FA;
  background: #FFFFFF;
  line-height: 1;
  border-radius: 999rpx;
  box-shadow: 0 6rpx 18rpx rgba(74, 144, 217, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 140rpx;
  overflow: hidden;
}

.avatar-btn::after {
  border: none;
}

.login-avatar-preview {
  width: 100%;
  height: 100%;
  min-width: 100%;
  min-height: 100%;
  border-radius: 999rpx;
  background-color: #F0F0F0;
  display: block;
}

.login-avatar-hint {
  font-size: 24rpx;
  color: #999999;
  margin-top: 12rpx;
}

.login-nickname-wrap {
  margin-bottom: 36rpx;
}

.login-nickname-input {
  width: 100%;
  height: 84rpx;
  border: 2rpx solid #E0E0E0;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
  text-align: center;
  background: #F8F9FA;
}

.login-modal-btns {
  display: flex;
  gap: 20rpx;
}

.login-btn-cancel,
.login-btn-confirm {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 28rpx;
  border-radius: 16rpx;
  padding: 0;
  text-align: center;
  border: none;
}

.login-btn-cancel::after,
.login-btn-confirm::after {
  border: none;
}

.login-btn-cancel {
  background-color: #F5F5F5;
  color: #666666;
}

.login-btn-confirm {
  background: linear-gradient(135deg, #4A90D9, #6BA5E7);
  color: #FFFFFF;
  font-weight: 500;
}

.login-btn-cancel:active { opacity: 0.7; }
.login-btn-confirm:active { opacity: 0.8; }

/* 功能菜单 */
.menu-section {
  margin: 20rpx 24rpx;
  padding: 0;
  border-radius: 20rpx;
}

.menu-item {
  padding: 30rpx 28rpx;
  transition: background 0.15s;
}

.menu-item:active {
  background: #F5F8FB;
}

.menu-icon {
  font-size: 36rpx;
}

.menu-text {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.menu-divider {
  height: 1rpx;
  background-color: #F0F0F0;
  margin: 0 28rpx;
}

/* 底部信息 */
.footer-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0 40rpx;
}

.footer-subtitle {
  font-size: 20rpx;
  color: #CCCCCC;
  margin-top: 8rpx;
}

/* 消息中心 badge */
.menu-text-badge {
  font-size: 20rpx;
  color: #FFF;
  background: #FF5252;
  padding: 4rpx 14rpx;
  border-radius: 14rpx;
}

.admin-badge {
  padding: 5rpx 13rpx;
  border-radius: 14rpx;
  background: #EAF3FD;
  color: #3478C9;
  font-size: 20rpx;
}

.menu-tag-soon {
  font-size: 20rpx;
  color: #999;
  background: #F0F0F0;
  padding: 4rpx 14rpx;
  border-radius: 14rpx;
}

/* ---------- 保留：子页面共享样式（已不再内联使用，但保留向后兼容） ---------- */
.section-header { padding: 28rpx 24rpx 16rpx; }
.section-title { font-size: 32rpx; font-weight: 600; color: #333333; }
