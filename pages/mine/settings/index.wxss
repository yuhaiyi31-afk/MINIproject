page { background:#F4F6F8; }
.settings-page { padding:24rpx; }
.settings-card { margin-bottom:18rpx; padding:0 24rpx; border-radius:18rpx; background:#FFF; }
.profile-name { display:block; padding-top:24rpx; color:#2D3948; font-size:30rpx; font-weight:650; }
.profile-hint { display:block; padding:8rpx 0 24rpx; color:#969EA9; font-size:22rpx; }
.section-title { padding:10rpx 8rpx 14rpx; color:#8A939F; font-size:22rpx; }
.settings-row { display:flex; min-height:88rpx; align-items:center; justify-content:space-between; color:#303A49; font-size:26rpx; }
.arrow { color:#A2A9B2; }
.divider { height:1rpx; background:#EEF1F4; }
.logout { color:#D25349; }
.version { padding:54rpx 0 24rpx; color:#C1C6CD; font-size:22rpx; text-align:center; }
