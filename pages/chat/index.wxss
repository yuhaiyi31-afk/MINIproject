page { height:100%; overflow:hidden; background:#F3F5F7; }
.chat-loading { padding:160rpx 24rpx; color:#8E96A3; font-size:26rpx; text-align:center; }
.chat-page { height:100vh; box-sizing:border-box; display:flex; flex-direction:column; overflow:hidden; }
.chat-product { display:flex; align-items:center; padding:18rpx 24rpx; background:#FFF; box-shadow:0 4rpx 14rpx rgba(31,45,61,.05); z-index:2; }
.product-thumb { width:78rpx; height:78rpx; flex:0 0 78rpx; border-radius:18rpx; overflow:hidden; display:flex; align-items:center; justify-content:center; background:#EAF3FF; font-size:34rpx; }
.product-thumb image { width:100%; height:100%; }
.product-info { flex:1; min-width:0; margin-left:16rpx; }
.product-title { display:block; font-size:26rpx; color:#303846; font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.product-price { display:block; width:100%; min-width:0; margin-top:5rpx; overflow:hidden; font-size:25rpx; color:#FF6B35; font-weight:600; text-overflow:ellipsis; white-space:nowrap; }
.seller-name { max-width:190rpx; margin-left:12rpx; font-size:21rpx; color:#8E96A3; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.chat-messages { flex:1; height:0; box-sizing:border-box; padding:26rpx 22rpx; }
.message-row { display:flex; align-items:flex-start; margin-bottom:24rpx; }
.message-row.mine { flex-direction:row-reverse; }
.chat-avatar { width:70rpx; height:70rpx; flex:0 0 70rpx; border-radius:22rpx; overflow:hidden; display:flex; align-items:center; justify-content:center; background:#DCEBFA; color:#397FD6; font-size:25rpx; font-weight:600; }
.chat-avatar image { width:100%; height:100%; }
.bubble-wrap { max-width:70%; margin-left:14rpx; }
.mine .bubble-wrap { margin-left:0; margin-right:14rpx; display:flex; flex-direction:column; align-items:flex-end; }
.message-bubble { padding:18rpx 22rpx; border-radius:8rpx 24rpx 24rpx 24rpx; background:#FFF; color:#323A46; font-size:27rpx; line-height:1.5; box-shadow:0 3rpx 12rpx rgba(31,45,61,.05); word-break:break-all; }
.mine .message-bubble { border-radius:24rpx 8rpx 24rpx 24rpx; background:#4A90D9; color:#FFF; }
.message-time { display:block; margin-top:7rpx; font-size:19rpx; color:#A0A7B2; }
.quick-scroll { flex-shrink:0; box-sizing:border-box; padding:14rpx 20rpx; background:#FFF; white-space:nowrap; border-top:1rpx solid #ECEFF2; }
.quick-chip { display:inline-flex; align-items:center; height:54rpx; box-sizing:border-box; padding:0 22rpx; margin-right:12rpx; border-radius:27rpx; background:#F1F6FC; color:#4A78A8; font-size:23rpx; }
.chat-composer { flex-shrink:0; display:flex; align-items:center; gap:14rpx; padding:16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom)); background:#FFF; }
.chat-input { flex:1; min-width:0; height:76rpx; box-sizing:border-box; padding:0 24rpx; border-radius:38rpx; background:#F2F4F7; color:#333; font-size:27rpx; }
.send-btn { width:116rpx; height:72rpx; line-height:72rpx; box-sizing:border-box; margin:0; padding:0; border-radius:36rpx; background:#4A90D9; color:#FFF; font-size:26rpx; font-weight:600; }
.send-btn::after { border:none; }
.send-btn[disabled] { background:#C7D4E2; color:#FFF; }
