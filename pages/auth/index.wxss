page {
  height: 100%;
  background: linear-gradient(180deg, #EAF4FF 0%, #F7FAFD 48%, #FFFFFF 100%);
}

.auth-page {
  display: flex;
  min-height: 100vh;
  box-sizing: border-box;
  padding: calc(env(safe-area-inset-top) + 76rpx) 36rpx calc(env(safe-area-inset-bottom) + 40rpx);
  align-items: center;
  flex-direction: column;
}

.auth-brand { display: flex; align-items: center; flex-direction: column; }
.auth-logo { width: 150rpx; height: 150rpx; border-radius: 34rpx; box-shadow: 0 14rpx 34rpx rgba(52, 120, 201, .20); }
.auth-name { margin-top: 24rpx; color: #23354B; font-size: 38rpx; font-weight: 700; }
.auth-slogan { margin-top: 10rpx; color: #8391A2; font-size: 24rpx; letter-spacing: 3rpx; }

.auth-card {
  width: 100%;
  margin-top: 54rpx;
  padding: 38rpx 34rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(74, 144, 217, .12);
  border-radius: 28rpx;
  background: rgba(255,255,255,.96);
  box-shadow: 0 14rpx 44rpx rgba(35, 53, 75, .09);
}

.step-head { display: flex; align-items: center; }
.step-number { display: flex; width: 58rpx; height: 58rpx; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 50%; background: #E7F2FF; color: #3478C9; font-size: 27rpx; font-weight: 700; }
.step-copy { display: flex; min-width: 0; margin-left: 18rpx; flex-direction: column; }
.step-title { color: #26364A; font-size: 31rpx; font-weight: 700; }
.step-desc { margin-top: 7rpx; color: #8B96A4; font-size: 22rpx; line-height: 1.5; }

.wechat-button,
.primary-button {
  width: 100%;
  height: 88rpx;
  margin: 34rpx 0 0;
  padding: 0;
  border-radius: 18rpx;
  color: #FFFFFF;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 88rpx;
}
.wechat-button { background: #07C160; }
.primary-button { background: linear-gradient(135deg, #3478C9, #559AE2); }
.wechat-button::after, .primary-button::after, .avatar-button::after { border: none; }
.auth-rule { display: block; margin-top: 20rpx; color: #A0A8B2; font-size: 21rpx; text-align: center; }

.checking-dot { width: 18rpx; height: 18rpx; margin: 4rpx auto 20rpx; border-radius: 50%; background: #4A90D9; box-shadow: 0 0 0 12rpx rgba(74,144,217,.12); }
.checking-text { display: block; color: #758292; font-size: 25rpx; text-align: center; }

.verified-phone { display: flex; padding: 18rpx 22rpx; align-items: center; border-radius: 14rpx; background: #EEF9F2; color: #287B49; font-size: 23rpx; }
.verified-icon { display: flex; width: 34rpx; height: 34rpx; margin-right: 12rpx; align-items: center; justify-content: center; border-radius: 50%; background: #36A864; color: #FFFFFF; font-size: 20rpx; }
.profile-head { margin-top: 28rpx; }

.avatar-button { display: flex; width: 100%; height: 126rpx; margin: 28rpx 0 0; padding: 18rpx 22rpx; box-sizing: border-box; align-items: center; border-radius: 16rpx; background: #F6F8FA; color: #4A6078; }
.avatar-preview { width: 88rpx; height: 88rpx; flex-shrink: 0; border-radius: 50%; background: #E6ECF2; }
.avatar-action { margin-left: 22rpx; font-size: 26rpx; }
.nickname-input { width: 100%; height: 84rpx; margin-top: 20rpx; padding: 0 24rpx; box-sizing: border-box; border: 2rpx solid #E1E7ED; border-radius: 16rpx; background: #F9FAFB; color: #26364A; font-size: 27rpx; }

.auth-error { display: block; max-width: 640rpx; margin-top: 24rpx; color: #C64E45; font-size: 22rpx; line-height: 1.5; text-align: center; }
.privacy-note { margin-top: auto; padding-top: 42rpx; color: #A6AEB8; font-size: 20rpx; line-height: 1.5; text-align: center; }
.consent-card .step-copy { margin-left:0; }
.consent-check { display:flex; margin-top:28rpx; align-items:center; flex-wrap:wrap; color:#566272; font-size:23rpx; line-height:1.8; }
.consent-box { display:flex; width:38rpx; height:38rpx; margin-right:12rpx; align-items:center; justify-content:center; box-sizing:border-box; border:2rpx solid #B5BDC7; border-radius:7rpx; color:#FFF; }
.consent-box.checked { border-color:#3478C9; background:#3478C9; }
.consent-link { margin:0 6rpx; color:#3478C9; }
.consent-links { display:flex; margin-top:20rpx; justify-content:space-between; color:#6D7E91; font-size:21rpx; }
