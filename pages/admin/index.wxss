page {
  min-height: 100%;
  background: #F4F6F8;
  color: #263142;
}

.admin-page { padding-bottom: 60rpx; }

.admin-header {
  padding: 34rpx 28rpx 28rpx;
  background: linear-gradient(135deg, #26364A, #3F5874);
  color: #FFFFFF;
}

.admin-title { display: block; font-size: 38rpx; font-weight: 700; }
.admin-subtitle { display: block; margin-top: 10rpx; color: rgba(255,255,255,.72); font-size: 23rpx; }

.admin-tabs {
  position: sticky;
  top: 0;
  z-index: 5;
  display: flex;
  padding: 0 24rpx;
  background: #FFFFFF;
  box-shadow: 0 3rpx 12rpx rgba(30, 43, 60, .06);
}

.admin-tab {
  position: relative;
  flex: 1;
  height: 88rpx;
  color: #788292;
  font-size: 27rpx;
  line-height: 88rpx;
  text-align: center;
}

.admin-tab.active { color: #3478C9; font-weight: 650; }
.admin-tab.active::after {
  position: absolute;
  right: 34%;
  bottom: 0;
  left: 34%;
  height: 5rpx;
  border-radius: 4rpx;
  background: #3478C9;
  content: '';
}

.state-card,
.empty-card {
  margin: 24rpx;
  padding: 70rpx 24rpx;
  border-radius: 18rpx;
  background: #FFFFFF;
  color: #9098A4;
  font-size: 25rpx;
  text-align: center;
}

.state-card.error { color: #C94A4A; }

.report-card,
.list-card {
  margin: 20rpx 24rpx 0;
  border-radius: 18rpx;
  background: #FFFFFF;
  box-shadow: 0 3rpx 14rpx rgba(30, 43, 60, .05);
}

.report-card { padding: 24rpx; }
.card-top, .list-card { display: flex; align-items: center; }

.item-thumb {
  width: 104rpx;
  height: 104rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  border-radius: 13rpx;
  background: #EEF1F4;
}

.card-copy, .list-copy { flex: 1; min-width: 0; }
.item-title, .list-title { display: block; overflow: hidden; font-size: 28rpx; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
.card-meta { display: block; margin-top: 8rpx; color: #9AA2AD; font-size: 21rpx; }

.status {
  margin-left: 14rpx;
  padding: 7rpx 13rpx;
  border-radius: 14rpx;
  font-size: 20rpx;
}
.status.pending { background: #FFF1D9; color: #B36B16; }
.status.actioned { background: #E7F5EC; color: #27834C; }
.status.dismissed { background: #EEF0F3; color: #737C88; }

.report-reason { margin-top: 22rpx; color: #D45A37; font-size: 27rpx; font-weight: 650; }
.report-detail { display: block; margin-top: 10rpx; color: #596273; font-size: 25rpx; line-height: 1.6; word-break: break-all; }
.people-row { display: flex; justify-content: space-between; margin-top: 18rpx; color: #8A929E; font-size: 21rpx; }
.resolution { display: block; margin-top: 16rpx; color: #397654; font-size: 23rpx; }

.action-row { display: flex; gap: 12rpx; margin-top: 22rpx; flex-wrap:wrap; }
.action, .small-action { margin: 0; padding: 0; font-size: 23rpx; }
.action { flex: 1; height: 66rpx; border-radius: 12rpx; line-height: 66rpx; }
.action::after, .small-action::after { border: none; }
.action.ghost { background: #F0F2F5; color: #65707E; }
.action.warn { background: #FFF0E5; color: #C46725; }
.action.danger { background: #D9564A; color: #FFFFFF; }
.action.danger-outline { background:#FFF1EF; color:#C64D43; }

.list-card { padding: 22rpx; }
.list-avatar {
  display: flex;
  width: 86rpx;
  height: 86rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #E6EEF7;
  color: #3478C9;
  font-size: 30rpx;
}
.list-avatar.square { border-radius: 12rpx; }
.list-status { display: block; margin-top: 8rpx; font-size: 21rpx; }
.list-status.active { color: #27834C; }
.list-status.unlisted { color: #A0A6AE; }
.list-status.sold { color:#6F7885; }
.list-status.suspended { color:#C46725; }
.list-status.deleted,.list-status.deleting { color:#C64D43; }
.ban-reason { display: block; margin-top: 6rpx; color: #C85B50; font-size: 21rpx; }

.small-action {
  width: 104rpx;
  height: 58rpx;
  margin-left: 18rpx;
  border-radius: 29rpx;
  line-height: 58rpx;
}
.small-action.danger-outline { background: #FFF1EF; color: #C64D43; }
.small-action.restore { background: #EAF3FD; color: #3478C9; }
.item-admin-actions { display:flex; flex-shrink:0; flex-direction:column; gap:10rpx; }
.item-admin-actions .small-action { width:96rpx; margin-left:12rpx; }

.admin-footnote { padding: 34rpx 24rpx 0; color: #A2A9B3; font-size: 21rpx; text-align: center; }
