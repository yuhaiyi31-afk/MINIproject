.page { padding: 22rpx; background: #f3f7fb; min-height: 100vh; }
.heading { font-weight: 600; margin: 12rpx 0; }
.panel { background: #fff; margin: 16rpx 0; padding: 18rpx; border-radius: 18rpx; }
.input { box-sizing: border-box; padding: 14rpx; border-radius: 10rpx; margin: 6rpx 0 14rpx; min-height: 74rpx; background: #fff; }
.description { width: 100%; height: 180rpx; }
.photos { display: flex; flex-wrap: wrap; }
.photo { width: 30%; margin: 1.5%; }
.photo image { width: 100%; height: 145rpx; }
.error { color: #9a2c36; margin: 10rpx 0; }
.promise, .notice { color: #40596b; margin: 12rpx 0; }
button { margin: 12rpx 0; }
