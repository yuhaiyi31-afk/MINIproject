<view class="page">
  <label class="label" for="env">CloudBase 测试环境 ID</label>
  <input id="env" class="input" value="{{environmentId}}" disabled="{{busy}}" bindinput="onEnvironmentInput" />
  <button type="primary" disabled="{{busy}}" bindtap="loadList">读取在售商品</button>
  <view class="message" wx:if="{{loaded && !items.length}}">测试环境没有在售商品</view>
  <button class="listing" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" disabled="{{busy}}" bindtap="chooseItem">{{item.title}} · NZ$ {{item.priceCents / 100}}</button>

  <label class="label" for="item">商品 ID</label>
  <input id="item" class="input" value="{{itemId}}" disabled="{{busy}}" bindinput="onItemInput" />
  <button disabled="{{busy}}" bindtap="loadItem">核对商品详情</button>
  <button disabled="{{busy}}" bindtap="openTrade">交易联调</button>
  <view class="message" wx:if="{{busy}}">正在读取测试环境…</view>
  <view class="error" wx:if="{{error}}">{{error}}</view>
  <view class="result" wx:if="{{evidence}}">
    <text selectable>{{evidence.itemId}}</text>
    <text wx:if="{{evidence.status === 'SOLD'}}">已售</text>
    <text wx:else>在售 · NZ$ {{evidence.priceCents / 100}}</text>
    <button bindtap="copyEvidence">复制验收结果</button>
  </view>
</view>
