/* Shared by the original WeChat client and the uni-app x clients. */
.campus-screen { flex: 1; background-color: #F4F7F9; }
.campus-panel { background-color: #FFFFFF; border-radius: 16px; border: 1px solid #D9E3EA; }
.campus-h1 { color: #172E43; font-size: 26px; line-height: 34px; font-weight: 700; }
.campus-h2 { color: #172E43; font-size: 20px; line-height: 28px; font-weight: 700; }
.campus-body { color: #172E43; font-size: 15px; line-height: 22px; }
.campus-muted { color: #526778; font-size: 13px; line-height: 19px; }
.campus-primary { min-height: 44px; margin: 0; padding: 0 16px; border-radius: 12px; background-color: #215B98; color: #FFFFFF; font-size: 15px; font-weight: 600; line-height: 44px; text-align: center; }
.campus-secondary { min-height: 44px; margin: 0; padding: 0 14px; border-radius: 12px; background-color: #E8F2FC; color: #215B98; font-size: 14px; font-weight: 600; line-height: 44px; text-align: center; }
.campus-state { padding: 24px 16px; align-items: center; justify-content: center; }
.campus-query { display: flex; flex-direction: row; align-items: center; min-height: 48px; padding: 0 12px; border: 1px solid #D9E3EA; border-radius: 12px; background-color: #FFFFFF; }
.campus-query-icon { width: 20px; height: 20px; margin-right: 8px; }
.campus-query-field { flex: 1; min-width: 0; height: 44px; color: #172E43; font-size: 15px; }
.campus-divider { height: 1px; background-color: #D9E3EA; }

.listing-card { overflow: hidden; background-color: #FFFFFF; border: 1px solid #D9E3EA; border-radius: 16px; }
.listing-media { position: relative; overflow: hidden; background-color: #E8F2FC; }
.listing-cover { width: 100%; height: 100%; }
.listing-empty { position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }
.listing-placeholder { color: #526778; font-size: 12px; }
.listing-status { position: absolute; left: 8px; top: 8px; padding: 3px 8px; border-radius: 10px; background-color: #172E43; color: #FFFFFF; font-size: 12px; }
.listing-body { padding: 10px; }
.listing-title { color: #172E43; font-size: 15px; line-height: 21px; height: 42px; font-weight: 600; overflow: hidden; }
.listing-price { margin-top: 4px; color: #A63E1F; font-size: 18px; line-height: 25px; font-weight: 700; }
.listing-price-long { font-size: 13px; line-height: 25px; }
.listing-meta { margin-top: 4px; color: #526778; font-size: 12px; line-height: 17px; }
.campus-entry { display: flex; flex-direction: row; align-items: center; justify-content: space-between; min-height: 82px; padding: 14px 16px; border-radius: 16px; background-color: #215B98; }
.campus-entry-title { color: #FFFFFF; font-size: 22px; line-height: 28px; font-weight: 700; }
.campus-entry-note { color: #E8F2FC; font-size: 13px; line-height: 20px; }
.campus-entry-arrow { color: #FFFFFF; font-size: 24px; line-height: 30px; }

.listing-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 12px; margin: 0 16px 24px; }
.listing-card { height: 100%; box-sizing: border-box; }
.listing-media { padding-top: 75%; }
.listing-cover { position: absolute; inset: 0; }
.listing-body text, .campus-entry-note, .campus-entry-title { display: block; }
.listing-title { display: -webkit-box !important; -webkit-line-clamp: 2; -webkit-box-orient: vertical; word-break: break-word; }
.listing-price, .listing-meta { overflow-wrap: anywhere; }
