/* Main discovery screens. Dimensions are logical pixels on each platform. */
.discovery { display: flex; flex-direction: column; background-color: #F4F7F9; }
.safety-line { display: flex; flex-direction: row; align-items: center; min-height: 44px; padding: 0 16px; background-color: #FFF6E7; }
.safety-mark { width: 18px; height: 18px; margin-right: 8px; border-radius: 9px; line-height: 18px; text-align: center; font-size: 12px; font-weight: 700; color: #FFFFFF; background-color: #8A5717; }
.safety-copy { flex: 1; color: #734A18; font-size: 12px; line-height: 18px; }
.safety-arrow { color: #734A18; font-size: 18px; }
.discover-inner { padding: 0 16px 24px; }
.discover-search { margin-top: 12px; }
.catalog-search { display: flex; flex-direction: row; align-items: center; height: 48px; padding: 0 6px 0 12px; border: 1px solid #D9E3EA; border-radius: 14px; background-color: #FFFFFF; }
.catalog-loupe { width: 18px; height: 18px; margin-right: 8px; position: relative; }
.catalog-loupe-ring { position: absolute; top: 1px; left: 1px; width: 13px; height: 13px; border: 2px solid #637D90; border-radius: 7px; }
.catalog-loupe-stem { position: absolute; left: 11px; top: 13px; width: 6px; height: 2px; border-radius: 1px; background-color: #637D90; transform: rotate(45deg); }
.catalog-field { min-width: 0; flex: 1; height: 44px; margin: 0; padding: 0; font-size: 15px; color: #172E43; }
.catalog-submit,.catalog-clear { min-width: 44px; height: 44px; margin: 0; padding: 0 6px; color: #215B98; font-size: 14px; font-weight: 600; line-height: 44px; text-align: center; }
.catalog-clear { color: #526778; font-size: 20px; }
.discovery-heading { display: flex; flex-direction: row; height: 52px; align-items: center; justify-content: space-between; }
.discovery-title { font-size: 19px; font-weight: 700; line-height: 26px; color: #172E43; }
.discovery-place { font-size: 12px; color: #526778; }
.discovery-link { min-height: 44px; line-height: 44px; font-size: 13px; font-weight: 600; color: #215B98; }
.shortcuts { display: flex; flex-direction: row; flex-wrap: wrap; padding: 8px 0; border-radius: 16px; background-color: #FFFFFF; }
.shortcut-cell { width: 25%; height: 78px; display: flex; flex-direction: column; justify-content: center; align-items: center; }
.shortcut-badge { display: flex; width: 44px; height: 44px; align-items: center; justify-content: center; border-radius: 14px; }
.shortcut-image { width: 30px; height: 30px; }
.shortcut-name { margin-top: 4px; color: #172E43; font-size: 13px; font-weight: 600; line-height: 18px; }
.feed-grid { display: flex; flex-direction: row; flex-wrap: wrap; margin-left: -6px; margin-right: -6px; }
.feed-cell { width: 50%; padding: 0 6px 12px; }
.popular-services { display: flex; flex-direction: row; padding: 8px 0; border-radius: 14px; background-color: #FFFFFF; }
.popular-link { display: flex; flex: 1; min-height: 44px; flex-direction: row; align-items: center; justify-content: center; }
.popular-label { color: #215B98; font-size: 13px; font-weight: 600; }
.discover-actions { display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
.catalog-header { padding: 0 16px 8px; background-color: #FFFFFF; }
.catalog-heading { display: flex; height: 60px; flex-direction: row; align-items: center; justify-content: space-between; }
.catalog-title { font-size: 24px; line-height: 32px; font-weight: 700; color: #172E43; }
.catalog-publish { display: flex; flex-direction: row; align-items: center; justify-content: center; min-width: 84px; height: 44px; padding: 0 10px; border-radius: 12px; background-color: #215B98; }
.catalog-publish-label { font-size: 14px; font-weight: 600; line-height: 20px; color: #FFFFFF; }
.catalog-categories { width: 100%; height: 44px; margin-top: 10px; }
.catalog-rail { display: flex; flex-direction: row; align-items: center; }
.catalog-chip { flex-shrink: 0; height: 44px; margin-right: 8px; padding: 0 12px; border-radius: 14px; background-color: #F1F4F7; color: #465F72; font-size: 13px; line-height: 44px; }
.catalog-chip-selected { background-color: #E8F2FC; color: #215B98; font-weight: 700; }
.catalog-results { display: flex; flex-direction: row; align-items: center; justify-content: space-between; min-height: 48px; }
.catalog-count { color: #526778; font-size: 13px; line-height: 18px; }
.catalog-filter { min-height: 44px; padding: 0 8px; color: #215B98; font-size: 13px; font-weight: 600; line-height: 44px; }
.catalog-feed { padding: 12px 16px 0; }
.catalog-end { height: 50px; line-height: 50px; text-align: center; color: #526778; font-size: 12px; }
.catalog-note { margin-top: 8px; color: #526778; font-size: 12px; line-height: 18px; }
